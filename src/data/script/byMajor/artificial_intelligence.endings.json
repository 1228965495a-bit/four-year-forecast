[{"id":"ending_artificial_intelligence_mid_gg","title":"人工智能·训练提前终止","type":"mid_gg","priority":100,"conditions":{"all":[{"type":"flag","key":"artificial_intelligence_flag_mid_gg"}]},"summary":"你同时加载了毕设、秋招、论文和自我怀疑，内存终于诚实地报错。模型还没收敛，你先触发了 early stopping。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"暂停、求助或换路都不是失败。先保住运行环境，才有下一次训练。","shareText":"模型还没收敛，我先 early stopping 了。","resultTags":["mid_gg","本科人生紧急中止"],"endingId":"ending_artificial_intelligence_mid_gg","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_transfer_success","title":"人工智能·成功退出训练集","type":"transfer_success","priority":90,"conditions":{"all":[{"type":"flag","key":"artificial_intelligence_flag_transfer_success"}]},"summary":"你把 AI 从人生主模型降级成了辅助特征。新专业不保证轻松，但终于由你选择优化目标。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"把原专业学到的数学、代码或数据能力带走，它们可以迁移，不必清零。","shareText":"我不是离开风口，我只是成功退出训练集。","resultTags":["transfer_success","半路重开型玩家"],"endingId":"ending_artificial_intelligence_transfer_success","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_transfer_fail","title":"人工智能·转专业请求未通过验证集","type":"transfer_fail","priority":88,"conditions":{"all":[{"type":"flag","key":"artificial_intelligence_flag_transfer_failed"}]},"summary":"你认真提交了转专业申请，系统返回：名额不足。逃生门没开，但你已经比只收藏攻略时更了解自己。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"重新设计路线：辅修、跨专业项目和应用岗位，都是比原地耗尽更实际的出口。","shareText":"我的转专业请求在验证集上表现不佳，现已返回 AI 主线。","resultTags":["transfer_fail","AI 原地滞留型幸存者"],"endingId":"ending_artificial_intelligence_transfer_fail","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_tuner","title":"隐藏结局·人形超参数搜索器","type":"hidden","priority":80,"conditions":{"all":[{"type":"majorStat","key":"mathFoundation","op":">=","value":85},{"type":"majorStat","key":"projectPackaging","op":">=","value":85},{"type":"stat","key":"obsession","op":">=","value":85},{"type":"achievement","achievementId":"ach_artificial_intelligence_reproduced_paper"},{"type":"achievement","achievementId":"ach_artificial_intelligence_closed_loop"}]},"summary":"你遇到任何问题都会先调学习率、改 batch size、看日志。朋友问你最近怎么样，你说：还没收敛，但 loss 在降。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"你是真的适合研究和调试。也请记得，人不是模型，不必每次都拿指标证明价值。","shareText":"遇到人生问题，我先把学习率调小。","resultTags":["hidden","人形调参器"],"endingId":"ending_artificial_intelligence_tuner","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_overachiever","title":"人工智能·实验记录比人生完整","type":"overachiever","priority":70,"conditions":{"all":[{"type":"majorStat","key":"projectPackaging","op":">=","value":75},{"type":"stat","key":"gpaWill","op":">=","value":80},{"type":"majorStat","key":"mathFoundation","op":">=","value":60},{"type":"stat","key":"energy","op":">=","value":30}]},"summary":"你的仓库有清晰 README、完整消融实验和能复现的环境。唯一没被记录的，是你凌晨三点对显卡说过的话。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"能力已经很强，下一步是选择值得长期投入的问题，别把自己训练过拟合。","shareText":"我的实验都可复现，除了本科四年的精神状态。","resultTags":["overachiever","项目卷王飞升型选手"],"endingId":"ending_artificial_intelligence_overachiever","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_true_love","title":"人工智能·看到 loss 下降真的会开心","type":"true_love","priority":65,"conditions":{"all":[{"type":"stat","key":"obsession","op":">=","value":85},{"type":"majorStat","key":"mathFoundation","op":">=","value":70},{"type":"majorStat","key":"modelHype","op":"<=","value":45},{"type":"stat","key":"energy","op":">=","value":30}]},"summary":"你被环境、数据和公式反复教育，却依然会为一次有效实验兴奋。别人看曲线，你看见模型终于听懂了一点。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"继续走下去。保留这种好奇心，它比追逐每一个新热词更耐用。","shareText":"别人看 loss 是一条线，我看 loss 下降像看孩子会走路。","resultTags":["true_love","真香型模型玩家"],"endingId":"ending_artificial_intelligence_true_love","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_algorithm_edge","title":"人工智能·算法岗 JD 常驻观察员","type":"route","priority":58,"conditions":{"all":[{"type":"route","key":"artificial_intelligence_route_job"},{"type":"majorStat","key":"algorithmShadow","op":">=","value":60},{"type":"stat","key":"careerFantasy","op":"<=","value":70},{"type":"majorStat","key":"projectPackaging","op":">=","value":35}]},"summary":"你和算法岗维持着复杂关系：每天看它要求什么，每周补一点，每次投递都被重新校准。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"把焦虑拆成基础、项目和面试三个清单，同时准备相邻岗位，别只押一条窄路。","shareText":"算法岗 JD 我都背熟了，就差算法岗认识我。","resultTags":["route","算法岗边缘人"],"endingId":"ending_artificial_intelligence_algorithm_edge","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_application","title":"人工智能·从造模型转向调用模型","type":"route","priority":55,"conditions":{"all":[{"type":"route","key":"artificial_intelligence_route_application"},{"type":"hiddenStat","key":"routeFlexibility","op":">=","value":1},{"type":"stat","key":"obsession","op":">=","value":40},{"type":"stat","key":"energy","op":">=","value":25}]},"summary":"你不再执着于亲手训练每个模型，而是把接口、产品和真实需求接起来。模型是不是你训的不重要，问题是你解决的。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"应用不是低配算法。懂技术边界又懂场景的人，往往更能让 AI 真正落地。","shareText":"模型是不是我训的不重要，接口是我调通的。","resultTags":["route","应用转向型现实玩家"],"endingId":"ending_artificial_intelligence_application","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_survivor","title":"人工智能·嘴上说泡沫，手上刷新新模型","type":"survivor","priority":45,"conditions":{"all":[{"type":"stat","key":"obsession","op":">=","value":45},{"type":"stat","key":"energy","op":">=","value":20},{"type":"stat","key":"energy","op":"<=","value":60},{"type":"hiddenStat","key":"stubbornness","op":">=","value":65}]},"summary":"你已经不信“AI 一键改变世界”，但每次新模型发布还是会点进去测两题。滤镜没了，好奇心还在。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"保留判断力：追踪变化可以，别让热词替你做职业选择。","shareText":"我嘴上说 AI 都是泡沫，手上已经打开了新模型。","resultTags":["survivor","未来感嘴硬型幸存者"],"endingId":"ending_artificial_intelligence_survivor","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_filter_broken","title":"人工智能·风口体验卡到期","type":"filter_broken","priority":40,"conditions":{"all":[{"type":"stat","key":"filter","op":"<=","value":15},{"type":"stat","key":"obsession","op":"<=","value":35},{"type":"stat","key":"escapeImpulse","op":">=","value":65}]},"summary":"报志愿时你想训练未来，入学后你主要在清洗缺失值、修环境和等显卡。所谓人工智能，很多时候是人工先把数据弄智能。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"慎重选择。喜欢名字不等于喜欢它的日常，先看看课程、作业和真实岗位再决定。","shareText":"报 AI 前我想改变世界，报 AI 后我在清洗 CSV。","resultTags":["filter_broken","风口滤镜破碎型误入者"],"endingId":"ending_artificial_intelligence_filter_broken","description":"","condition":{},"majorId":"artificial_intelligence"},{"id":"ending_artificial_intelligence_layflat","title":"人工智能·准确率能交就别再调","type":"layflat","priority":10,"conditions":{"all":[{"type":"stat","key":"obsession","op":"<=","value":55},{"type":"stat","key":"gpaWill","op":"<=","value":50},{"type":"stat","key":"energy","op":">","value":20}],"none":[{"type":"flag","key":"artificial_intelligence_flag_mid_gg"}]},"summary":"你的模型没有 SOTA，项目没有改变行业，但答辩当天它居然跑通了。四年目标函数非常朴素：毕业。","afterEffects":["看到模型先问数据","听到智能会自动想损失函数"],"advice":"能毕业是一种结果，但如果还想吃这碗饭，基础和项目迟早需要补回来。","shareText":"我的模型没有 SOTA，只有答辩能跑。","resultTags":["layflat","摆烂毕业型幸存者"],"endingId":"ending_artificial_intelligence_layflat","description":"","condition":{},"majorId":"artificial_intelligence"}]